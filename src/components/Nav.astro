---
import { github, nav } from "../data/site";
import SearchTrigger from "./navigation/SearchTrigger.astro";
import GitHubIcon from "./navigation/GitHubIcon.astro";
const links = [...nav, { label: "Brand & assets", href: "/brand/" }];
const hrefFor = (href: string) =>
  href.startsWith("#") && Astro.url.pathname !== "/" ? `/${href}` : href;
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="header wrap">
  <a class="brand" href="/" aria-label="Smeltery Labs home">
    <img src="/mark.svg" alt="" width="32" height="32" />
    <span>
      smeltery<span class="brand-sub"> / labs</span>
    </span>
  </a>
  <nav class="desktop-nav" aria-label="Primary">
    {links.map((item) => (
      <a
        href={hrefFor(item.href)}
        aria-current={
          Astro.url.pathname.replace(/\/$/, "") === item.href.replace(/\/$/, "")
            ? "page"
            : undefined
        }
      >
        {item.label}
      </a>
    ))}
  </nav>
  <SearchTrigger />
  <a class="github" href={github}>
    <GitHubIcon /> GitHub
  </a>
  <button
    class="menu-toggle"
    type="button"
    aria-haspopup="dialog"
    aria-controls="mobile-menu"
    aria-expanded="false"
  >
    Menu{" "}
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</header>
<style>
  .header {
    position: sticky;
    top: 16px;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
    padding: 12px 22px;
    background: #fffffff2;
    backdrop-filter: blur(16px);
    border: 1px solid var(--line);
    border-radius: 999px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    white-space: nowrap;
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.045em;
  }
  .brand-sub {
    color: var(--muted);
    font-weight: 400;
  }
  .desktop-nav {
    display: flex;
    gap: 4px;
    align-items: center;
  }
  .desktop-nav a {
    padding: 10px 14px;
    border-radius: 999px;
    font-size: 13px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .desktop-nav a:hover,
  .desktop-nav a[aria-current] {
    background: #eceee5;
  }
  .github,
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 16px;
    min-height: 44px;
    border-radius: 999px;
    font-size: 13px;
  }
  .github {
    background: var(--ink);
    color: white;
  }
  .github:hover {
    background: var(--green);
  }
  .menu-toggle {
    display: none;
    border: 1px solid var(--line);
    background: transparent;
  }
  .menu-toggle:hover {
    background: #eceee5;
  }
  @media (max-width: 900px) {
    .header {
      top: 10px;
      margin-top: 10px;
      padding: 8px 12px;
    }
    .brand {
      font-size: 17px;
    }
    .brand img {
      width: 28px;
      height: 28px;
    }
    .desktop-nav,
    .github {
      display: none;
    }
    .menu-toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 360px) {
    .brand-sub {
      display: none;
    }
    .header {
      gap: 8px;
    }
    .menu-toggle {
      padding-inline: 12px;
    }
  }
</style>
