---
import { github, nav } from "../data/site";
---

<a class="skip-link" href="#main">
  Skip to content
</a>
<header class="header wrap">
  <a class="brand" href="/" aria-label="Smeltery Labs home">
    <img src="/mark.svg" alt="" width="26" height="26" />
    smeltery<span>labs</span>
  </a>
  <nav aria-label="Primary">
    {nav.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <a class="github" href={github}>
      GitHub <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffffbd;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.055em;
  }
  .brand span {
    color: var(--muted);
    font-weight: 400;
    margin-left: -3px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 12px;
  }
  nav a {
    padding-block: 8px;
  }
  nav a:hover {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .github {
    padding: 8px 15px;
    background: var(--ink);
    color: white;
    border-radius: 999px;
  }
  nav .github:hover {
    color: white;
    background: var(--green);
  }
  @media (max-width: 640px) {
    .header {
      padding: 8px 12px;
      margin-top: 12px;
    }
    .brand {
      font-size: 15px;
    }
    .brand span {
      display: none;
    }
    nav {
      gap: 14px;
      font-size: 11px;
    }
    .github {
      padding: 8px 10px;
    }
  }
</style>
