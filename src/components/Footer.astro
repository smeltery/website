---
import { footer } from "../data/site";
---

<footer class="footer wrap">
  <div class="top">
    <div class="about">
      <a class="brand" href="/">
        <img src="/mark.svg" alt="" width="28" height="28" loading="lazy" />
        smeltery labs
      </a>
      <p>
        A small collective dedicated
        <br />
        to the craft of software.
      </p>
    </div>
    <nav class="cols" aria-label="Footer">
      {footer.map((col) => (
        <div class="col">
          <p class="title">{col.title}</p>
          <ul>
            {col.links
              .filter((link) => link.only !== "mobile")
              .map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="bottom">
    <p>© 2026 Smeltery Labs. Built in the open.</p>
    <span class="hot">
      <i aria-hidden="true"></i>forge hot
    </span>
  </div>
</footer>
<style>
  .footer {
    padding-top: 70px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding-bottom: 48px;
  }
  .brand {
    display: flex;
    gap: 9px;
    align-items: center;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.05em;
  }
  .about p {
    margin-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .title {
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 16px;
  }
  ul {
    display: grid;
    gap: 9px;
    font-size: 11px;
    color: var(--muted);
  }
  ul a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .bottom {
    border-top: 1px solid var(--line);
    padding-block: 23px;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--muted);
  }
  .hot {
    display: flex;
    gap: 7px;
    align-items: center;
  }
  .hot i {
    width: 6px;
    height: 6px;
    background: #84946d;
    border-radius: 50%;
  }
  @media (max-width: 760px) {
    .top {
      flex-direction: column;
    }
    .cols {
      gap: 20px;
    }
  }
  @media (max-width: 480px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
    .bottom {
      font-size: 10px;
      gap: 12px;
    }
  }
</style>
