---
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  lede?: string;
}
const { eyebrow, title, accent, lede } = Astro.props;
---

<div class="head">
  <p class="eyebrow">{eyebrow}</p>
  <h2>
    {title} <em>{accent}</em>
  </h2>
  {lede && <p class="lede">{lede}</p>}
</div>
<style>
  .head {
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
  }
  .lede {
    margin-top: 18px;
    font-size: 15px;
    text-wrap: balance;
  }
</style>
