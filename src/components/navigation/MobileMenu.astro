---
import GitHubIcon from "./GitHubIcon.astro";
import SearchTrigger from "./SearchTrigger.astro";
import { github, tools } from "../../data/site";
import "../../styles/navigation.css";
const home = Astro.url.pathname === "/" ? "" : "/";
---

<dialog id="mobile-menu" class="mobile-menu" aria-labelledby="menu-title">
  <div class="menu-header">
    <a class="menu-brand" href="/" aria-label="Smeltery Labs home">
      <img src="/mark.svg" width="28" height="28" alt="" />
      <span>
        smeltery <span>/ labs</span>
      </span>
    </a>
    <button type="button" class="menu-close" aria-label="Close navigation" autofocus>
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
  <div class="menu-content">
    <p class="eyebrow">A little direction goes a long way</p>
    <h2 id="menu-title">What’s next?</h2>
    <SearchTrigger menu />
    <nav class="menu-cards" aria-label="Mobile navigation">
      <a class="featured" href={`${home}#tools`}>
        <span class="menu-symbol" aria-hidden="true">
          ▦
        </span>
        <span>
          <strong>Explore tools</strong>
          <small>Find a little less friction in your day.</small>
        </span>
        <span aria-hidden="true">→</span>
      </a>
      <a href={`${home}#skills`}>
        <span class="menu-symbol" aria-hidden="true">
          ✳
        </span>
        <strong>Agent skills</strong>
        <small>A better way to plan, build, and review.</small>
      </a>
      <a href={`${home}#principles`}>
        <span class="menu-symbol" aria-hidden="true">
          ◇
        </span>
        <strong>Our principles</strong>
        <small>The care behind the tools we make.</small>
      </a>
    </nav>
    <div class="menu-section-title">
      <h3>Meet the tools</h3>
      <span>Small tools. Good company.</span>
    </div>
    <nav class="menu-tools" aria-label="Projects">
      {tools.map((tool) => (
        <a href={`${github}/${tool.name}`}>
          {tool.icon ? (
            <img src={tool.icon} width="30" height="30" alt="" />
          ) : (
            <span class="tool-placeholder" aria-hidden="true">
              ~/
            </span>
          )}
          <span>{tool.name}</span>
          <small>{tool.platform}</small>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
    <a
      class="menu-brand-link"
      href="/brand/"
      aria-current={Astro.url.pathname.startsWith("/brand") ? "page" : undefined}
    >
      Brand & assets <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="menu-footer">
    <a href={github} style="gap: 8px">
      <GitHubIcon /> GitHub
    </a>
    <a href={`${github}/website/issues`}>Feedback & issues ↗</a>
  </div>
</dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>("#mobile-menu");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const closeButton = menu?.querySelector<HTMLButtonElement>(".menu-close");
  if (menu && toggle && closeButton) {
    toggle.addEventListener("click", () => {
      menu.showModal();
      toggle.setAttribute("aria-expanded", "true");
    });
    const closeMenu = () => menu.close();
    closeButton.addEventListener("click", closeMenu);
    menu.addEventListener("close", () => {
      toggle.setAttribute("aria-expanded", "false");
      if (window.matchMedia("(max-width: 900px)").matches) {
        toggle.focus({ preventScroll: true });
      }
    });
    menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
      if (event.matches && menu.open) closeMenu();
    });
  }
</script>
