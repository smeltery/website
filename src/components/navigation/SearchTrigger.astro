---
import "../../styles/search-trigger.css";
const { menu = false } = Astro.props;
---

<button
  type="button"
  class:list={["search-trigger", { "menu-search": menu }]}
  data-open-search
  aria-label="Search tools, skills, and pages"
  aria-haspopup="dialog"
  aria-controls="site-search"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="10.5" cy="10.5" r="6.5" />
    <path d="m16 16 4 4" />
  </svg>
  <span>{menu ? "Search tools, skills & pages" : "Search"}</span>
  <kbd data-search-shortcut>⌘ K</kbd>
</button>
