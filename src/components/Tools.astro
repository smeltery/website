---
import { github, tools } from "../data/site";
import SectionHead from "./SectionHead.astro";
---

<section class="tools wrap" id="tools">
  <SectionHead
    eyebrow="The toolbox"
    title="Small tools."
    accent="Good company."
    lede="For the jobs you actually have. Each one solves a sharp problem, with a little care for the details."
  />
  <ul class="list">
    {tools.map((tool) => (
      <li>
        <a class="card" href={`${github}/${tool.name}`}>
          <div class="top">
            {tool.icon ? (
              <img src={tool.icon} alt="" width="48" height="48" loading="lazy" />
            ) : (
              <span class="setup" aria-hidden="true">
                ~ /
              </span>
            )}
            <span class="platform">{tool.platform}</span>
          </div>
          <h3>{tool.name}</h3>
          <p>{tool.blurb}</p>
          <div class="bottom">
            <span>{tool.category}</span>
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </div>
        </a>
      </li>
    ))}
    <li class="all">
      <a class="card" href={github}>
        <span class="collection" aria-hidden="true">
          ✳
        </span>
        <h3>
          There’s more
          <br />
          <em>in the forge.</em>
        </h3>
        <p>Find the next little thing that makes your day a little better.</p>
        <div class="bottom">
          <span>Explore all projects</span>
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </div>
      </a>
    </li>
  </ul>
  <p class="fine">Made for real workflows. Built in the open.</p>
</section>
<style>
  .tools {
    padding-block: 110px 96px;
  }
  .list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 40px;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 25px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #ffffffa8;
    transition:
      transform var(--ease),
      box-shadow var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 25px #292b2509;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .platform {
    font-size: 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px 9px;
    color: var(--muted);
  }
  .setup {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: #e8ecdf;
    color: var(--green);
    border: 1px solid #d9dfcc;
    border-radius: 12px;
    font: 16px var(--font-mono);
    rotate: -6deg;
  }
  h3 {
    font-size: 21px;
    margin-bottom: 10px;
  }
  .card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }
  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 26px;
    font-size: 11px;
    color: var(--muted);
  }
  .arrow {
    font-size: 18px;
    color: var(--ink);
  }
  .all .card {
    background: #eceee5;
    border-color: #e0e4d6;
  }
  .collection {
    color: #7f8e69;
    font-size: 38px;
    line-height: 48px;
    margin-bottom: 24px;
  }
  .all h3 {
    font-size: 26px;
  }
  .fine {
    text-align: center;
    margin-top: 24px;
  }
  @media (max-width: 760px) {
    .list {
      grid-template-columns: repeat(2, 1fr);
    }
    .tools {
      padding-block: 80px;
    }
  }
  @media (max-width: 480px) {
    .list {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 24px;
    }
    .top {
      margin-bottom: 18px;
    }
  }
</style>
