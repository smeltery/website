---
import { github } from "../data/site";
import Terminal from "./Terminal.astro";
---

<section class="hero wrap">
  <div class="intro">
    <div class="confetti" aria-hidden="true">
      <img class="float ember" src="/tools/ember.svg" alt="" width="60" height="60" />
      <img class="float fugue" src="/tools/fugue.svg" alt="" width="60" height="60" />
      <img class="float context" src="/tools/context.svg" alt="" width="60" height="60" />
      <img class="float airlock" src="/tools/airlock.svg" alt="" width="60" height="60" />
      <span class="spark one">✳</span>
      <span class="spark two">✦</span>
    </div>
    <p class="eyebrow">
      <span class="dot"></span> A small collective. A lot of little tools.
    </p>
    <h1>
      Less friction.
      <br />
      More <em>making.</em>
    </h1>
    <p class="lede">
      Thoughtful developer tools for the work you love.
      <br class="desk-only" /> From your first command to your next big idea.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="#tools">
        Find your next tool <span aria-hidden="true">↓</span>
      </a>
      <a class="text-link" href={github}>
        Explore the forge ↗
      </a>
    </div>
    <p class="fine">Built in the open. Made to fit your day.</p>
  </div>
  <div class="workbench">
    <div class="note">
      <p class="eyebrow">A little less in your way</p>
      <h2>
        Your workflow.
        <br />
        <em>With room to breathe.</em>
      </h2>
      <p class="lede">
        AI agents, everyday CLIs, and a setup that feels like yours. Small tools that do their job,
        then get out of the way.
      </p>
      <a class="text-link" href={`${github}/fugue`}>
        Meet fugue <span aria-hidden="true">↗</span>
      </a>
    </div>
    <Terminal />
  </div>
</section>
<style>
  .intro {
    position: relative;
    padding: 105px 0 76px;
    text-align: center;
  }
  h1 {
    font-size: clamp(52px, 7vw, 78px);
    line-height: 1.04;
    letter-spacing: -0.065em;
  }
  h1 em {
    color: var(--green);
  }
  .intro .lede {
    margin: 25px auto;
    font-size: 16px;
    max-width: 450px;
  }
  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #82906a;
    border-radius: 50%;
    margin: 0 7px 1px 0;
  }
  .actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-bottom: 16px;
  }
  .confetti {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .float {
    position: absolute;
    filter: drop-shadow(0 10px 8px #292b2512);
    animation: bob 6s ease-in-out infinite alternate;
  }
  .ember {
    left: 7%;
    top: 105px;
    rotate: -16deg;
  }
  .fugue {
    right: 7%;
    top: 115px;
    rotate: 13deg;
    animation-delay: -2s;
  }
  .context {
    left: 1%;
    top: 300px;
    rotate: 10deg;
    animation-delay: -4s;
  }
  .airlock {
    right: 2%;
    top: 320px;
    rotate: -13deg;
    animation-delay: -1s;
  }
  .spark {
    position: absolute;
    color: #b4bda3;
    font-size: 25px;
  }
  .one {
    left: 19%;
    top: 250px;
  }
  .two {
    right: 19%;
    top: 60px;
    color: #d3bb79;
  }
  .workbench {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: 42px;
    padding: 40px;
    background: #eceee5;
    border: 1px solid #e1e4d8;
    border-radius: 24px;
  }
  .note h2 {
    font-size: 29px;
  }
  .note .lede {
    font-size: 14px;
    margin: 18px 0;
  }
  @keyframes bob {
    to {
      transform: translateY(-10px);
    }
  }
  @media (max-width: 760px) {
    .intro {
      padding-top: 90px;
    }
    .float {
      width: 40px;
      height: 40px;
    }
    .ember {
      left: 2%;
      top: 28px;
    }
    .fugue {
      right: 3%;
      top: 35px;
    }
    .context,
    .airlock,
    .spark {
      display: none;
    }
    .workbench {
      grid-template-columns: 1fr;
      padding: 26px;
      gap: 26px;
    }
    .note {
      max-width: 420px;
    }
  }
  @media (max-width: 380px) {
    .actions {
      gap: 16px;
      flex-direction: column;
    }
    .workbench {
      padding: 20px 14px;
    }
  }
</style>
