---
import { ghostMode } from "../data/site";
---

<figure class="term" aria-label="Illustrative preview of fugue ghost mode">
  <figcaption class="chrome">
    <span class="lights" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span>fugue — ghost mode</span>
  </figcaption>
  <div class="body">
    <p class="cmd">
      <span class="ps">~</span> fugue claude
      <br />
      <span class="arg">"refactor the auth module"</span>
    </p>
    <p class="badge">
      <span aria-hidden="true">●</span> Ghost mode active
    </p>
    <dl>
      {ghostMode.map(([label, value, shortLabel, shortValue]) => (
        <div>
          <dt>
            <span class="desk-only">{label}</span>
            <span class="mobile-only">{shortLabel}</span>
          </dt>
          <dd>
            <span class="desk-only">{value}</span>
            <span class="mobile-only">{shortValue}</span>
          </dd>
        </div>
      ))}
    </dl>
    <p class="caption">
      <span aria-hidden="true">↳</span> A little more peace of mind.
      <span class="cursor" aria-hidden="true"></span>
    </p>
  </div>
</figure>
<style>
  .term {
    min-width: 0;
    background: #ffffff;
    border: 1px solid #d8dcd0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow:
      0 12px 28px #353c2510,
      0 2px 4px #353c2508;
    font: 11px/1.6 var(--font-mono);
    transform: rotate(1deg);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 16px;
    background: #f9f9f6;
    padding: 13px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 10px;
  }
  .lights {
    display: flex;
    gap: 5px;
  }
  .lights i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #dfa49a;
  }
  .lights i:nth-child(2) {
    background: #dec484;
  }
  .lights i:nth-child(3) {
    background: #a9bc96;
  }
  .body {
    padding: 24px 20px;
  }
  .cmd {
    font-size: 12px;
  }
  .ps {
    color: var(--green);
  }
  .arg {
    color: var(--muted);
    padding-left: 15px;
  }
  .badge {
    display: inline-flex;
    gap: 7px;
    background: #edf2e8;
    color: #526447;
    border-radius: 5px;
    padding: 5px 9px;
    margin: 19px 0 14px;
    font-size: 10px;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 0;
    border-top: 1px solid #eeeee8;
  }
  dt {
    color: var(--muted);
  }
  dd {
    color: var(--green);
    text-align: right;
  }
  .caption {
    margin-top: 20px;
    font-size: 10px;
    color: var(--muted);
  }
  .cursor {
    display: inline-block;
    width: 5px;
    height: 11px;
    background: #96a385;
    margin-left: 7px;
    vertical-align: middle;
  }
  @media (max-width: 640px) {
    .term {
      transform: none;
    }
    .body {
      padding: 20px 14px;
    }
  }
</style>
