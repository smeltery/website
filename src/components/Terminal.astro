---
import { ghostMode, github } from "../data/site";
---

<div class="stage">
  <figure class="term" aria-label="fugue running a coding agent in ghost mode">
    <div class="chrome" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
      <span>fugue · ghost mode</span>
    </div>
    <div class="body">
      <p class="cmd">
        <span class="ps">$</span>
        <span>
          fugue claude <span class="arg">"refactor the auth module"</span>
        </span>
      </p>
      <p class="badge">
        <img src="/tools/fugue.svg" alt="" width="20" height="20" />
        Ghost mode active
      </p>
      <dl>
        {ghostMode.map(([label, value, shortLabel, shortValue]) => (
          <div>
            <dt>
              <span class="desk-only">{label}</span>
              <span class="mobile-only">{shortLabel}</span>
            </dt>
            <dd>
              <span class="desk-only">{value}</span>
              <span class="mobile-only">{shortValue}</span>
            </dd>
          </div>
        ))}
      </dl>
      <p class="caption">
        <span class="arrow">→</span>
        <span class="desk-only">One of 90+ tools from Smeltery</span>
        <span class="mobile-only">One of 90+ Smeltery tools</span>
        <a class="desk-only" href={github}>
          browse the forge
        </a>
      </p>
    </div>
  </figure>
  <img class="palm" src="/3d/palm.webp" alt="" width="180" height="180" />
</div>

<style>
  .stage {
    position: relative;
  }
  .term {
    display: flex;
    flex-direction: column;
    overflow: clip;
    background: var(--color-neutral-900);
    border-left: 6px solid var(--color-primary);
    font: 13px/16px var(--font-mono);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 16px;
    background: #141414;
    color: #888888;
    font-size: 12px;
  }
  .chrome i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .chrome i:nth-child(2) {
    background: var(--color-primary);
  }
  .chrome i:nth-child(3) {
    background: var(--color-secondary);
  }
  .chrome span {
    padding-left: 8px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 28px 24px 32px;
  }
  .cmd {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--color-neutral-50);
    font-size: 14px;
    line-height: 18px;
  }
  .ps,
  .arrow {
    color: var(--color-primary);
  }
  .badge {
    display: flex;
    align-items: center;
    align-self: start;
    gap: 10px;
    padding: 8px 12px;
    background: #1f1a00;
    color: var(--color-primary);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  dl {
    border-top: 1px solid #2a2a2a;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-inline: -10px;
    padding: 12px 10px;
    color: #aaaaaa;
    transition: background var(--ease);
  }
  dl div:not(:last-child) {
    border-bottom: 1px solid #2a2a2a;
  }
  dl div:hover {
    background: #1f1a00;
    color: var(--color-neutral-50);
  }
  dd {
    color: var(--color-primary);
    font-weight: 600;
  }
  .caption {
    display: flex;
    gap: 10px;
    padding-top: 8px;
    color: var(--color-neutral-50);
  }
  .caption a {
    color: #888888;
    transition: color var(--ease);
  }
  .caption a:hover {
    color: var(--color-primary);
  }
  .palm {
    position: absolute;
    top: -69px;
    right: -30px;
  }

  @media (max-width: 1023px) {
    .term {
      border-left-width: 4px;
    }
    .chrome {
      gap: 6px;
      padding: 12px 14px;
      font-size: 11px;
      line-height: 14px;
    }
    .chrome i {
      width: 8px;
      height: 8px;
    }
    .chrome span {
      padding-left: 6px;
    }
    .body {
      gap: 14px;
      padding: 18px 14px 20px;
      font-size: 12px;
    }
    .cmd {
      gap: 8px;
      font-size: 13px;
      line-height: 16px;
    }
    .arg {
      display: block;
      margin-top: 6px;
      color: #aaaaaa;
    }
    .badge {
      gap: 8px;
      padding: 6px 10px;
      font-size: 11px;
      line-height: 14px;
    }
    .badge img {
      width: 16px;
      height: 16px;
    }
    dl div {
      gap: 12px;
      padding-block: 10px;
    }
    .caption {
      gap: 8px;
      padding-top: 4px;
    }
    .palm {
      top: -36px;
      right: 8px;
      width: 110px;
      height: 110px;
    }
  }
</style>
