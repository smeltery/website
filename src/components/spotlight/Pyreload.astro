---
import { projectUrl } from "../../data/site";
const url = projectUrl("pyreload-cli");
---

<section class="pyreload wrap" aria-labelledby="pyreload-title">
  <div class="copy">
    <div class="identity">
      <img src="/repositories/pyreload-cli.svg" width="44" height="44" alt="" loading="lazy" />
      <p class="eyebrow">Meet PyReload · A smoother Python workflow</p>
    </div>
    <h2 id="pyreload-title">
      Save. Reload.
      <br />
      <em>Keep making.</em>
    </h2>
    <p class="description">
      Your code changed. Your app should keep up. PyReload watches your files and restarts your
      Python app, so you can stay with the idea instead of reaching for the terminal.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={url} target="_blank" rel="noopener noreferrer">
        Explore PyReload <span aria-hidden="true">↗</span>
      </a>
      <a
        class="text-link"
        href={`${url}docs/getting-started/installation/`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Set up your first reload <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="note">Working in Docker or on a mounted filesystem? Polling mode has you covered.</p>
  </div>
  <figure class="terminal" aria-label="Illustration of PyReload’s watch and restart workflow">
    <figcaption>
      <span class="dots" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span>one less thing to do by hand</span>
    </figcaption>
    <div class="terminal-body">
      <p class="command">
        <span aria-hidden="true">$ </span>
        <code>pyreload app.py</code>
      </p>
      <ol class="steps">
        <li>
          <span class="step-number">01</span>
          <div>
            <strong>Watch your files</strong>
            <p>Keep working in your editor.</p>
          </div>
        </li>
        <li>
          <span class="step-number">02</span>
          <div>
            <strong>Save a change</strong>
            <p>PyReload notices what changed.</p>
          </div>
        </li>
        <li>
          <span class="step-number">03</span>
          <div>
            <strong>Pick up where you left off</strong>
            <p>Your Python app restarts automatically.</p>
          </div>
        </li>
      </ol>
      <span class="status">
        <span aria-hidden="true">↻</span> Ready for the next idea.
      </span>
    </div>
  </figure>
</section>
<style>
  .pyreload {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: 48px;
    padding: 40px;
    margin-bottom: 40px;
    border: 1px solid #dde3d2;
    border-radius: 24px;
    background: #ecefe5;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }
  .identity img {
    flex-shrink: 0;
  }
  .identity .eyebrow {
    margin: 0;
  }
  h2 {
    font-size: clamp(30px, 3.2vw, 40px);
  }
  h2 em {
    color: var(--green);
  }
  .description {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
    max-width: 470px;
    margin-top: 20px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 24px;
    margin-top: 28px;
  }
  .text-link {
    font-size: 13px;
  }
  .note {
    font-size: 12px;
    color: var(--muted);
    max-width: 420px;
    margin-top: 20px;
  }
  .terminal {
    border: 1px solid #d6decb;
    border-radius: 16px;
    background: #fafbf7;
    box-shadow: 0 16px 32px #29351e0d;
    transform: rotate(-1deg);
    overflow: hidden;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-bottom: 1px solid #e1e6d9;
    font: 10px var(--font-mono);
    color: var(--muted);
  }
  .dots {
    display: flex;
    gap: 5px;
  }
  .dots i {
    width: 6px;
    height: 6px;
    background: #b3bea3;
    border-radius: 50%;
  }
  .terminal-body {
    padding: 24px;
  }
  .command {
    font: 14px var(--font-mono);
    padding-bottom: 24px;
  }
  .command span {
    color: #82906a;
  }
  .steps {
    display: grid;
    gap: 22px;
  }
  .steps li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .step-number {
    font: 11px var(--font-mono);
    color: #7b896b;
    padding-top: 3px;
  }
  .steps strong {
    font-size: 13px;
    font-weight: 550;
  }
  .steps p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 4px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--green);
    background: #eaf0e1;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 11px;
    margin-top: 26px;
  }
  @media (max-width: 760px) {
    .pyreload {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 26px;
    }
  }
  @media (max-width: 380px) {
    .pyreload {
      padding: 20px;
    }
    figcaption {
      padding-inline: 14px;
      gap: 10px;
    }
    .terminal-body {
      padding: 20px;
    }
  }
</style>
