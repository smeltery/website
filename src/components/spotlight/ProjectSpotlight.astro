---
import { spotlightProjects as projects } from "../../data/spotlight";
import Terminal from "../Terminal.astro";
import "../../styles/spotlight.css";
---

<section
  class="spotlight wrap"
  aria-label="Discover a project"
  aria-roledescription="carousel"
  data-spotlight
>
  <div class="spotlight-slides" aria-live="off">
    {projects.map((project, index) => (
      <div
        class="spotlight-slide"
        data-slide
        hidden={index !== 0}
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} of ${projects.length}: ${project.label}`}
      >
        <div class="spotlight-copy">
          <div class="spotlight-identity">
            <img src={project.logo} width="32" height="32" alt="" />
            <span>{project.label}</span>
          </div>
          <h2>
            {project.title}
            <br />
            <em>{project.accent}</em>
          </h2>
          <p>{project.description}</p>
          <a class="btn btn-primary" href={project.url} target="_blank" rel="noopener noreferrer">
            Explore {project.label} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="spotlight-preview" aria-hidden="true">
          {project.image ? (
            <img src={project.image} width="1200" height="630" alt="" loading="lazy" />
          ) : project.name === "fugue" ? (
            <Terminal />
          ) : null}
        </div>
      </div>
    ))}
  </div>
  <div class="spotlight-controls">
    <details data-project-picker>
      <summary>
        <img data-selected-logo src={projects[0]!.logo} width="24" height="24" alt="" />
        <span data-selected-name>{projects[0]!.label}</span>
        <span data-position>1 / {projects.length}</span>
        <span class="picker-chevron" aria-hidden="true">
          ⌄
        </span>
      </summary>
      <div class="spotlight-picker">
        <label for="spotlight-filter">Switch project</label>
        <input
          id="spotlight-filter"
          type="search"
          placeholder="Find a project…"
          autocomplete="off"
        />
        <div class="spotlight-options" role="group" aria-label="Featured projects">
          {projects.map((project, index) => (
            <button
              type="button"
              data-project={index}
              data-name={project.label}
              data-keywords={`${project.name} ${project.description}`}
              aria-pressed={index === 0}
            >
              <img src={project.logo} width="24" height="24" alt="" />
              <span>{project.label}</span>
              <span class="selected-check" aria-hidden="true">
                ✓
              </span>
            </button>
          ))}
        </div>
        <p data-empty hidden>
          No projects found. Try another name.
        </p>
      </div>
    </details>
    <button
      class="spotlight-rotation"
      type="button"
      data-rotation
      aria-label="Pause project rotation"
    >
      Pause
    </button>
  </div>
</section>
<script>
  import "../../scripts/spotlight";
</script>
