---
import { projectUrl } from "../../data/site";
const url = projectUrl("hermes");
---

<section class="hermes wrap" aria-labelledby="hermes-title">
  <div class="copy">
    <div class="identity">
      <img src="/repositories/hermes.svg" width="44" height="44" alt="" loading="lazy" />
      <p class="eyebrow">Meet Hermes · Logging for modern Java</p>
    </div>
    <h2 id="hermes-title">
      Let your application talk.
      <br />
      <em>Skip the boilerplate.</em>
    </h2>
    <p class="description">
      Keep your attention on the code that matters. Hermes brings compile-time logger injection,
      asynchronous logging, and Spring Boot integration to your Java projects.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={url} target="_blank" rel="noopener noreferrer">
        Explore Hermes <span aria-hidden="true">↗</span>
      </a>
      <a
        class="text-link"
        href={`${url}docs/getting-started/quick-start`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Start logging <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="fine-print">Java · Spring Boot · Kotlin</p>
  </div>
  <a
    class="preview"
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Explore Hermes logging"
  >
    <img
      src="/spotlight/hermes.webp"
      width="1200"
      height="630"
      alt="Hermes logging library preview"
      loading="lazy"
    />
    <span class="preview-caption">
      <span>A little less setup. A clearer picture.</span>
      <span aria-hidden="true">↗</span>
    </span>
  </a>
</section>
<style>
  .hermes {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 48px;
    align-items: center;
    margin-top: 0;
    margin-bottom: 40px;
    padding: 40px;
    border: 1px solid #d9e2dd;
    border-radius: 24px;
    background: #e9eeeb;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }
  .identity .eyebrow {
    margin: 0;
  }
  h2 {
    font-size: clamp(28px, 3.2vw, 40px);
  }
  h2 em {
    color: #48665c;
  }
  .description {
    margin-top: 20px;
    max-width: 470px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 24px;
    margin-top: 28px;
  }
  .text-link {
    font-size: 13px;
  }
  .fine-print {
    font-size: 11px;
    color: var(--muted);
    margin-top: 18px;
  }
  .preview {
    display: block;
    background: #fffdf7;
    border: 1px solid #e1d8c5;
    border-radius: 16px;
    overflow: hidden;
    transform: rotate(1.5deg);
    box-shadow: 0 16px 32px #604e3010;
    transition:
      transform var(--ease),
      box-shadow var(--ease);
  }
  .preview:hover {
    transform: rotate(0);
    box-shadow: 0 20px 36px #604e301a;
  }
  .preview img {
    display: block;
    width: 100%;
    height: auto;
  }
  .preview-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-top: 1px solid #d9e2dd;
    font-size: 12px;
    color: #48665c;
  }
  @media (max-width: 760px) {
    .hermes {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 26px;
    }
    .preview {
      transform: rotate(1deg);
    }
  }
  @media (max-width: 380px) {
    .hermes {
      padding: 20px;
    }
  }
</style>
