---
const agents = [
  { name: "Codex", icon: "codex" },
  { name: "Claude Code", icon: "claude" },
  { name: "OpenCode", icon: "opencode" },
  { name: "Cursor", icon: "cursor" },
];
---

<div class="agents" aria-label="Coding agents">
  {agents.map((agent) => (
    <span class="agent">
      <img src={`/agents/${agent.icon}.svg`} width="18" height="18" alt="" loading="lazy" />
      <span>{agent.name}</span>
    </span>
  ))}
</div>
<style>
  .agents {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .agent {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid #d5dacb;
    border-radius: 999px;
    background: #ffffff80;
    color: var(--muted);
    font-size: 12px;
    line-height: 20px;
    white-space: nowrap;
  }
  .agent img {
    display: block;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    object-fit: contain;
  }
</style>
