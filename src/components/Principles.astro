---
import { principles } from "../data/site";
import SectionHead from "./SectionHead.astro";
---

<section class="principles wrap" id="principles">
  <SectionHead
    eyebrow="A few things we believe"
    title="Software should feel"
    accent="on your side."
    lede="Different tools. The same care behind every one."
  />
  <ol>
    {principles.map((item, index) => (
      <li>
        <span class="num">0{index + 1}</span>
        <div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
<style>
  .principles {
    border-top: 1px solid var(--line);
    padding-block: 80px;
  }
  ol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 34px 64px;
    max-width: 760px;
    margin: 48px auto 0;
  }
  li {
    display: flex;
    gap: 20px;
  }
  .num {
    color: #858e76;
    font:
      italic 22px Georgia,
      serif;
  }
  h3 {
    font-size: 17px;
    margin: 3px 0 8px;
  }
  li p {
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 640px) {
    ol {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .principles {
      padding-block: 64px;
    }
  }
</style>
