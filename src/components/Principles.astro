---
import { principles } from "../data/site";
---

<section class="principles wrap" id="principles" aria-labelledby="principles-title">
  <header>
    <p class="eyebrow">A few things we believe</p>
    <h2 id="principles-title">
      Software should feel
      <br />
      <em>on your side.</em>
    </h2>
    <p class="lede">Different tools. The same care behind every one.</p>
  </header>
  <ol>
    {principles.map((item, index) => (
      <li>
        <span class="num" aria-hidden="true">
          0{index + 1}
        </span>
        <div>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
<style>
  .principles {
    padding-block: 72px;
    scroll-margin-top: 110px;
  }
  header {
    text-align: center;
    max-width: 620px;
    margin-inline: auto;
  }
  h2 {
    font-size: clamp(30px, 3.5vw, 44px);
    line-height: 1.15;
    text-wrap: balance;
  }
  h2 em {
    color: var(--green);
  }
  .lede {
    margin-top: 16px;
    color: var(--muted);
    font-size: 15px;
    text-wrap: balance;
  }
  ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 32px 0 0;
  }
  li {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #ffffff80;
  }
  .num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: #e8ecdf;
    color: var(--green);
    font: 12px var(--font-mono);
  }
  h3 {
    font-size: 19px;
    margin-bottom: 10px;
  }
  li p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.65;
  }
  @media (max-width: 1000px) {
    ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .principles {
      padding-block: 56px;
    }
    ol {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 24px;
    }
    li {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
    }
    .num {
      flex-shrink: 0;
      margin-bottom: 0;
    }
    h3 {
      margin-bottom: 6px;
    }
  }
</style>
