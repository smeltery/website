---
import { command, github } from "../data/site";
---

<section class="hello wrap">
  <div class="art" aria-hidden="true">
    <img src="/3d/anvil.webp" alt="" width="100" height="100" loading="lazy" />
  </div>
  <p class="eyebrow">Your next idea is waiting</p>
  <h2>
    A little less setup.
    <br />
    <em>A little more possibility.</em>
  </h2>
  <p class="lede">Say hello from your terminal.</p>
  <button class="btn btn-cmd" data-copy={command} aria-label="Copy npx smeltery" aria-live="polite">
    <span data-copy-label>{command}</span>
    <span aria-hidden="true">⧉</span>
  </button>
  <p class="fine">One command to meet the collective.</p>
  <a class="text-link" href={github}>
    Or have a look around GitHub ↗
  </a>
</section>
<style>
  .hello {
    text-align: center;
    padding: 45px 24px 60px;
    background: #eeeee7;
    border-radius: 24px;
  }
  .art img {
    margin: 0 auto 15px;
  }
  .hello .lede {
    margin: 22px 0;
    font-size: 15px;
  }
  .btn-cmd {
    font-family: var(--font-mono);
    min-width: 190px;
  }
  .fine {
    margin-top: 13px;
  }
  .text-link {
    display: inline-block;
    margin-top: 27px;
  }
</style>
