---
import { github } from "../data/site";
---

<section class="hello wrap">
  <div class="art" aria-hidden="true">
    <img src="/3d/anvil.webp" alt="" width="100" height="100" loading="lazy" />
  </div>
  <p class="eyebrow">Your next idea is waiting</p>
  <h2>
    A little less setup.
    <br />
    <em>A little more possibility.</em>
  </h2>
  <a class="text-link" href={github}>
    Explore Smeltery on GitHub ↗
  </a>
</section>
<style>
  .hello {
    text-align: center;
    padding: 45px 24px 60px;
    background: #eeeee7;
    border-radius: 24px;
  }
  .art img {
    margin: 0 auto 15px;
  }
  .text-link {
    display: inline-block;
    margin-top: 27px;
  }
</style>
