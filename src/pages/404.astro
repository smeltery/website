---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="Page not found · Smeltery Labs"
  description="This page could not be found. Browse Smeltery tools or return home."
>
  <Nav />
  <main id="main" class="wrap missing">
    <p class="eyebrow">404 · Page not found</p>
    <h1>A little off the path.</h1>
    <p>The page may have moved, or the address may be incorrect.</p>
    <a class="btn btn-primary" href="/">
      Back to Smeltery <span aria-hidden="true">→</span>
    </a>
  </main>
  <Footer />
</Base>
<style>
  .missing {
    padding-block: 100px;
    text-align: center;
  }
  h1 {
    font-size: clamp(32px, 5vw, 56px);
  }
  .missing > p:not(.eyebrow) {
    color: var(--muted);
    margin: 24px 0;
  }
</style>
