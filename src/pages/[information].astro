---
import { information } from "../data/information";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
export function getStaticPaths() {
  return Object.entries(information).map(([slug, page]) => ({
    params: { information: slug },
    props: { page },
  }));
}
const { page } = Astro.props;
---

<Base title={`${page.title} · Smeltery`} description={page.paragraphs[0] ?? page.title}>
  <Nav />
  <main id="main" class="wrap information">
    <p class="eyebrow">Smeltery Labs</p>
    <h1>{page.title}</h1>
    {page.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <a
      class="text-link"
      href="https://github.com/smeltery/website/issues"
      target="_blank"
      rel="noopener noreferrer"
    >
      Website questions and feedback ↗
    </a>
    <a
      class="text-link"
      href="https://github.com/orgs/smeltery/repositories"
      target="_blank"
      rel="noopener noreferrer"
    >
      Browse project repositories ↗
    </a>
  </main>
  <Footer />
</Base>
<style>
  .information {
    max-width: 760px;
    padding-block: 72px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 48px);
    margin-bottom: 28px;
  }
  .information > p:not(.eyebrow) {
    color: var(--muted);
    line-height: 1.8;
    margin-bottom: 24px;
  }
  .text-link {
    display: table;
    margin-top: 20px;
  }
</style>
