---
import { information } from "../data/information";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/information.css";
export function getStaticPaths() {
  return Object.entries(information).map(([slug, page]) => ({
    params: { information: slug },
    props: { page, slug },
  }));
}
const { page, slug } = Astro.props;
const external = (href: string) => href.startsWith("https://");
---

<Base title={`${page.title} · Smeltery`} description={page.introduction}>
  <Nav />
  <main id="main" class:list={["wrap", "information", slug]}>
    <header class="page-intro">
      <div>
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>
          <span>{page.heading}</span>
          <em>{page.accent}</em>
        </h1>
        <p class="introduction">{page.introduction}</p>
      </div>
      <div class="intro-art" aria-hidden="true">
        <img
          src={`/3d/${slug === "about" ? "anvil" : slug === "contact" ? "palm" : "crucible"}.webp`}
          width="160"
          height="160"
          alt=""
        />
      </div>
    </header>
    <ul class="highlights" aria-label="At a glance">
      {page.highlights.map((text) => (
        <li>
          <span aria-hidden="true">✓</span>
          {text}
        </li>
      ))}
    </ul>
    <div class="page-body">
      <nav class="contents" aria-label="On this page">
        <p>On this page</p>
        {page.sections.map((section) => (
          <a href={`#${section.id}`}>{section.title}</a>
        ))}
      </nav>
      <div class="sections">
        {page.sections.map((section, index) => (
          <section class="info-section" id={section.id} aria-labelledby={`${section.id}-title`}>
            <span class="section-number" aria-hidden="true">
              0{index + 1}
            </span>
            <div>
              <h2 id={`${section.id}-title`}>{section.title}</h2>
              <p>{section.text}</p>
              {section.link && (
                <a
                  class="text-link"
                  href={section.link.href}
                  target={external(section.link.href) ? "_blank" : undefined}
                  rel={external(section.link.href) ? "noopener noreferrer" : undefined}
                >
                  {section.link.label}{" "}
                  <span aria-hidden="true">{external(section.link.href) ? "↗" : "→"}</span>
                </a>
              )}
            </div>
          </section>
        ))}
      </div>
    </div>
    <aside class="page-closing" aria-labelledby="closing-title">
      <div>
        <h2 id="closing-title">{page.closing.title}</h2>
        <p>{page.closing.text}</p>
      </div>
      <a class="btn btn-primary" href={page.closing.href} target="_blank" rel="noopener noreferrer">
        {page.closing.label} <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </main>
  <Footer />
</Base>
