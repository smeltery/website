---
import "@fontsource-variable/dm-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import Search from "../components/navigation/Search.astro";
import MobileMenu from "../components/navigation/MobileMenu.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Smeltery Labs · Developer tools for coding agents and Mac workflows",
  description = "Developer tools that cut the friction out of building. 90+ open projects for AI agents, machine setup, and everyday CLIs.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="is-agentic-site-type" content="business" />
    <link
      rel="alternate"
      type="text/markdown"
      href="/llms-full.txt"
      title="Smeltery project directory"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f2" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/mark.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Smeltery Labs",
        url: Astro.site?.href,
        description,
        logo: new URL("/mark.svg", Astro.site).href,
        sameAs: ["https://github.com/smeltery", "https://smeltery-skills.vercel.app"],
      }).replace(/</g, "\\u003c")}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
  </head>
  <body id="top">
    <slot />
    <MobileMenu />
    <Search />
    <script>
      for (const link of document.querySelectorAll<HTMLAnchorElement>("a[href]")) {
        const destination = new URL(link.href, location.href);
        if (
          ["http:", "https:"].includes(destination.protocol) &&
          destination.origin !== location.origin &&
          !link.hasAttribute("download")
        ) {
          link.target = "_blank";
          link.relList.add("noopener", "noreferrer");
        }
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
        const label = button.querySelector<HTMLElement>("[data-copy-label]") ?? button;
        const originalText = label.textContent;
        let resetTimer: ReturnType<typeof setTimeout>;
        button.addEventListener("click", async () => {
          clearTimeout(resetTimer);
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? "");
            label.textContent = "copied";
          } catch (error) {
            console.error("clipboard write failed", error);
            label.textContent = "copy blocked";
          }
          resetTimer = setTimeout(() => (label.textContent = originalText), 1600);
        });
      }
    </script>
  </body>
</html>
